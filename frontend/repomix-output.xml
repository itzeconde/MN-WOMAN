                </div>
              )
            })}
          </div>
          {seleccionada && (
            <button
              onClick={() => setSeleccionada(null)}
              style={{
                marginTop: '16px', background: 'none', border: 'none',
                color: '#B66878', fontSize: '13px', cursor: 'pointer', padding: 0,
              }}
            >
              ← Ver todas las instituciones
