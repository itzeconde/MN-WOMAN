    """
    Igual que ServicioSerializer, pero bloquea 'activo' — eso se cambia
    solo desde ToggleActivoServicioView.
    """
    class Meta(ServicioSerializer.Meta):
        read_only_fields = ServicioSerializer.Meta.read_only_fields + ('activo',)
